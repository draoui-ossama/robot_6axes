<?xml version="1.0"?>
<robot name="test_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Robot materials -->
    <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.8 0.1 0.3 1.0"/>
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>
    

    <!-- Base link -->
    <link name="world">
    </link>
    <joint name="world_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        
    </joint>
    <link name="base_link">
        <parent link="world_joint"/>
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.10"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.15" length="0.10"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="5.0"/>
            <origin xyz="0 0 0"/>
            <inertia
                ixx="0.05" ixy="0" ixz="0"
                iyy="0.05" iyz="0"
                izz="0.08"/>
        </inertial>

    </link>
    <joint name="base_joint" type="revolute">
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="1 0 0" rpy="0.0 0.0 0.0"/>
        <limit lower="0" upper="1.570796" effort="0.1" velocity="1"/>
        <parent link="base_link"/>
        <child link="arm_link"/>
    </joint>
   <!-- First arm link -->
    <link name="arm_link">

        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.05" length="0.30"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.07" length="0.30"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.15"/>
            <mass value="2.0"/>
            <inertia
                ixx="0.016" ixy="0" ixz="0"
                iyy="0.016" iyz="0"
                izz="0.005"/>
        </inertial>

    </link>
   
    <joint name="forearm_joint" type="revolute">
        <origin xyz="0 0 0.30" rpy="0 0 0"/>
        <axis xyz="1 0 0" rpy="0.0 0.0 0.0"/>
        <limit lower="0" upper="1.570796" effort="0.1" velocity="1"/>
        <parent link="arm_link"/>
        <child link="forearm_link"/>
    </joint>
   
    <link name="forearm_link">

        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.03" length="0.30"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.45"/>
            <geometry>
                <cylinder radius="0.07" length="0.30"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.15"/>
            <mass value="2.0"/>
            <inertia
                ixx="0.016" ixy="0" ixz="0"
                iyy="0.016" iyz="0"
                izz="0.005"/>
        </inertial>

    </link>

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="base_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
         <joint name="forearm_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
    <gazebo>
        <plugin
            filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>
                <parameters>/home/ossama/Desktop/ROBOTICS/first_exemple/ros2_ws/src/test_robot/config/controllers.yaml</parameters>
            </parameters>

        </plugin>
    </gazebo>


</robot>
